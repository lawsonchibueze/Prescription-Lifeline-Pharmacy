{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter api prisma:generate && pnpm --filter api build",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/shared/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter api exec prisma migrate deploy && pnpm --filter api prisma:seed",
    "startCommand": "pnpm --filter api start:prod",
    "healthcheckPath": "/api",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
