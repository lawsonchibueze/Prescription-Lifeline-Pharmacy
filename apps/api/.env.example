# Copy this file to .env and adjust as needed.

# Matches the postgres service in the root docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prescription_lifeline?schema=public"

PORT=4000

# Comma-separated list of origins allowed to call the API in dev.
CORS_ORIGIN="http://localhost:3000"

# 32+ char random string, e.g: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:4000"

# Flutterwave — from your dashboard's API keys page (OAuth2 client
# credentials; Flutterwave's current API, not the older secret/public key
# pair). Checkout initialization isn't wired up yet — see
# src/payments/flutterwave.client.ts — but the webhook handler and its
# signature check work once these are set.
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
# The "secret hash" you set on the dashboard's webhook configuration page.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
